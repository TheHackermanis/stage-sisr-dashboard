# Copier ce fichier en ".env" puis remplir les valeurs.
# Ne jamais committer le fichier .env (il est dans .gitignore).

# --- France Travail (francetravail.io) ---
# Une seule application suffit pour les deux API :
#   - scope "api_offresdemploiv2" + "o2dsoffre"  -> Offres d'emploi v2
#   - scope "api_labonneboitev2"                  -> La Bonne Boîte
# Laisser vide : l'application fonctionne quand même, ces sources seront ignorées.
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# --- Enrichissement web ---
# Adresse de contact ajoutée au User-Agent (bonne pratique quand on visite des sites).
USER_AGENT_CONTACT=

# --- Serveur local ---
HOST=127.0.0.1
PORT=8000
